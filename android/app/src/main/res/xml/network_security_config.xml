<?xml version="1.0" encoding="utf-8"?>
<!-- The PC is reached over the home network by IP address, which has no HTTPS certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
