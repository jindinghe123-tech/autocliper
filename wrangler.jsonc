// Project website (site/) on Cloudflare — static assets only, no server code.
// Deploy / update:  npx wrangler deploy
// Every deploy first packs the download (site/AutoStudio.zip) from the latest commit, so commit before deploying;
// it also copies the Android app (autostudio/app/AutoStudio.apk) next to it.
{
  "name": "autostudio",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "git -c core.autocrlf=false archive --format=zip --prefix=AutoStudio/ -o site/AutoStudio.zip HEAD && node -e \"require('fs').copyFileSync('autostudio/app/AutoStudio.apk','site/AutoStudio.apk')\""
  },
  "assets": {
    "directory": "./site"
  }
}
