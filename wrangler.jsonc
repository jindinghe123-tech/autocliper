// Project website (site/) and the phone relay (relay/worker.js) on Cloudflare.
// Deploy / update:  npx wrangler deploy
// Every deploy first runs scripts/build-site.mjs: it packs the download (site/AutoStudio.zip) from the latest
// commit — so commit before deploying — copies the Android app next to it, and writes site/update.json, which
// installed copies read to update themselves.
{
  "name": "autostudio",
  "main": "relay/worker.js",
  "compatibility_date": "2026-10-06",
  "build": {
    "command": "node scripts/build-site.mjs"
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }]
}
